{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "paths": {
      "$pipeline/*": ["../src/*"]
    },
    "types": [
      "node",
      "bun",
      "$app/types"
    ]
  },
  "include": [
    "src",
    "scripts"
  ],
  "exclude": [
    "src/service-worker.ts"
  ]
}
