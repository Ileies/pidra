# Database
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL_EXTRACTION=gpt-5.6-luna
OPENAI_MODEL_SYNTHESIS=gpt-5.6-luna

# Email / IMAP
# IMAP_LOOKBACK_DAYS=1  # default 1; set to 7 for first run to catch all recent emails
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true

# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Tasks list that system-created items go to, by name (default "To-Do Now"). An unknown name
# falls back to @default, which is whichever list the account lists first.
GOOGLE_TASKS_DEFAULT_LIST=To-Do Now

# Question API (SMS gateway or local endpoint)
QUESTION_API_ENDPOINT=

# Skills bridge
SKILLS_BRIDGE_PORT=4000

# Pipeline schedule (cron syntax)
PIPELINE_CRON=30 6 * * *

# Extra addresses of your own - never classified as an incoming action item. Comma-separated.
# Added to (not replacing) every account in email-accounts.json, so list only the addresses the
# pipeline does not read from, e.g. a work address or an alias. Deliberately not in source:
# this repository is public.
SELF_EMAILS=you@work.example,alias@example.com

# Brave Search (Phase 4)
BRAVE_SEARCH_API_KEY=

# Context Builder
CONTEXT_BUILDER_EMAIL_YEARS=3            # how far back to go for personal emails (default 3)
CONTEXT_BUILDER_EXTRACT_CONCURRENCY=8    # parallel extraction calls to OpenAI (default 8)
CONTEXT_BUILDER_MAX_RSS_MB=4096          # self-abort above this RSS (default 4096)
CONTEXT_BUILDER_OUTPUT_DIR=context-builder/output
GITHUB_TOKEN=                            # PAT with repo scope for private repos
GKEEPAPI_USERNAME=                       # Google account email for gkeepapi
GKEEPAPI_MASTER_TOKEN=                   # obtained via: bun run context-builder/scripts/keep-auth.py

# Rough cost readout in the Context Builder progress UI - set to the active model's real rates
AI_COST_PER_MTOK_IN=3.0
AI_COST_PER_MTOK_OUT=15.0
