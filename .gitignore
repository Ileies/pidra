# `.env` alone did not cover `.env.bak.<ts>`, which a credential rotation leaves behind on the
# server and which git then reports as untracked, one `git add -A` away from being published.
.env*
!.env.example
*.local
.DS_Store
.idea/
dashboard/.svelte-kit/
dashboard/build/
# Only the harvested documents, not the source next to them: the directory-wide pattern kept
# builder.ts and db-writer.ts out of version control entirely.
context-builder/output/*.json
context-builder/output/*.md
context-builder/.checkpoint.json
context-builder/errors.json
context-builder/.keep-token.json
context-builder/.venv/
