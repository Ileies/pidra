# Database
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL_EXTRACTION=gpt-6-luna
OPENAI_MODEL_SYNTHESIS=gpt-6-luna

# Email / IMAP
# IMAP_LOOKBACK_DAYS=1  # default 1; set to 7 for first run to catch all recent emails
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true

# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Tasks list that system-created items go to, by name (default "To-Do Now"). An unknown name
# falls back to @default, which is whichever list the account lists first.
GOOGLE_TASKS_DEFAULT_LIST=To-Do Now

# Question API (SMS gateway or local endpoint)
QUESTION_API_ENDPOINT=

# Skills bridge
SKILLS_BRIDGE_PORT=4000

# Pipeline schedule (cron syntax)
PIPELINE_CRON=30 6 * * *

# Extra addresses of your own - never classified as an incoming action item. Comma-separated.
# Added to (not replacing) every account configured on /settings/email-accounts, so list only the
# addresses the pipeline does not read from, e.g. a work address or an alias. Deliberately not in
# source: this repository is public.
SELF_EMAILS=you@work.example,alias@example.com

# Brave Search (news desks, Section 1 slots, web-search skill, deepen)
BRAVE_SEARCH_API_KEY=

# News desks (src/news/): Brave-backed research behind the briefing's News section.
# Your home, for the home desk and for localising the talk-of-the-day desk. Deliberately not in
# source: this repository is public. Without NEWS_HOME_COUNTRY the home desk does not run, and
# every briefing says so above the report until it is set. The country is an ISO 3166-1 alpha-2 code.
NEWS_HOME_CITY=Springfield
NEWS_HOME_REGION=
NEWS_HOME_COUNTRY=US
# Countries whose top national headlines you follow from abroad (citizenship, family), comma-separated.
NEWS_ALSO_COUNTRIES=
# A subset of world,home,beat,field,talk,serendipity, or "off". Unset runs all six.
# NEWS_DESKS=
# One reasoning effort for every desk's final extraction (low|medium|high). Search budgets stay fixed.
# NEWS_REASONING_EFFORT=
# Which numbered sections of the context document the beat and fields desks see. Default 3, the
# interests section; the others describe the person rather than what they follow.
# PIPELINE_CONTEXT_SECTIONS_NEWS=3

# Context Builder
CONTEXT_BUILDER_EMAIL_YEARS=3            # how far back to go for personal emails (default 3)
CONTEXT_BUILDER_EXTRACT_CONCURRENCY=8    # parallel extraction calls to OpenAI (default 8)
CONTEXT_BUILDER_MAX_RSS_MB=4096          # self-abort above this RSS (default 4096)
CONTEXT_BUILDER_OUTPUT_DIR=context-builder/output
GITHUB_TOKEN=                            # PAT with repo scope for private repos
GKEEPAPI_USERNAME=                       # Google account email for gkeepapi
GKEEPAPI_MASTER_TOKEN=                   # obtained via: bun run context-builder/scripts/keep-auth.py

# Dashboard login (dashboard/src/lib/server/auth.ts): a WebAuthn passkey, then a PIN.
# The relying-party ID and expected origin - default to pidra.de over https. Only set these
# if the dashboard runs somewhere else (a different host, or plain http for local dev).
# AUTH_RP_ID=
# AUTH_ORIGIN=
# One-time secret that opens /setup before any passkey is registered. Generate with
# `openssl rand -hex 32`; once a passkey exists the token stops working and /setup requires a
# session instead - set on each machine's own .env, never carried by a deploy.
AUTH_SETUP_TOKEN=

# Encrypts email_accounts.password at rest (AES-256-GCM, src/config/crypto.ts and
# dashboard/src/lib/server/crypto.ts). Generate with `openssl rand -hex 32` - set independently on
# each machine's own .env, like AUTH_SETUP_TOKEN above; never carried by a deploy. Losing this key
# means every stored email account password must be re-entered on /settings/email-accounts.
CONFIG_ENCRYPTION_KEY=

# Web Push (PWA notifications). Generate the pair once with: bunx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
# Contact the push service can use to reach you about a misbehaving sender. mailto: or https://.
VAPID_SUBJECT=mailto:you@example.com

# Token prices for the active model, USD per 1M tokens. Read by the dashboard's cost figures and
# by the Context Builder progress readout. Unset means cost renders as unavailable everywhere,
# which is on purpose - a wrong price is worse than no price. These are list prices; calls run on
# service_tier "flex", so real spend is lower.
PUBLIC_MODEL_PRICE_IN_PER_MTOK=0.10
PUBLIC_MODEL_PRICE_OUT_PER_MTOK=0.50
# Optional override for the Context Builder CLI readout only; defaults to the two above.
# AI_COST_PER_MTOK_IN=
# AI_COST_PER_MTOK_OUT=
