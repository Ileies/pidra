{
  "name": "pidra",
  "version": "0.1.0",
  "homepage": "https://github.com/Ileies/pidra",
  "private": true,
  "workspaces": ["dashboard"],
  "scripts": {
    "check": "bun run scripts/check.ts",
    "check:quick": "bun run scripts/check.ts --quick",
    "test": "bun test ./tests",
    "test:db": "bun run scripts/check-db-tests.ts",
    "dev": "bun run src/index.ts",
    "run:pipeline": "bun run src/pipeline/run.ts",
    "job": "bun run src/job.ts",
    "deploy": "bun run scripts/deploy.ts",
    "server": "bun run src/server/index.ts",
    "dry-run:news": "bun run scripts/news-dry-run.ts",
    "dry-run:actions": "bun run scripts/actions-dry-run.ts",
    "dry-run:questions": "bun run scripts/questions-dry-run.ts",
    "dashboard": "cd dashboard && bun run dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "context-builder": "bun run context-builder/run.ts",
    "context-builder:dry": "bun run context-builder/run.ts --dry-run",
    "context-builder:full": "bun run context-builder/run.ts --full",
    "news:dry": "bun run scripts/news-dry-run.ts",
    "actions:dry": "bun run scripts/actions-dry-run.ts",
    "questions:dry": "bun run scripts/questions-dry-run.ts",
    "jev:baseline": "bun run scripts/jev-baseline.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "drizzle-orm": "^1.0.0-rc.5-5935859",
    "googleapis": "^171.4.0",
    "hono": "^4.12.19",
    "imap": "^0.8.19",
    "libmime": "^5.4.3",
    "mailparser": "^3.9.8",
    "nodemailer": "^8.0.7",
    "openai": "^6.38.0",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/imap": "^0.8.43",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^1.0.0-rc.5-5935859",
    "typescript": "^7.0.2"
  }
}
